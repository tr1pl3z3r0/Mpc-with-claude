                Show          off
              }
              Parameter {
                Variable      "StartFcn"
                Value         ""
                Show          off
              }
              Parameter {
                Variable      "OutputFcn"
                Value         "//Xk son estados actuales\n"
"\n"
"    Xk[0] = InputSignal(0, 0);\n"
"    Xk[1] = InputSignal(0, 1);\n"
"\n"
"//Xeq  son referencias\n"
"\n"
"\t Xeq[0] = InputSignal(0, 2);\n"
"    Xeq[1] = InputSignal(0, 3);\n"
"    the = InputSignal(1, 0);\n"
"    fill_Xeq( );\n"
"\n"
"    OutputSignal(0, NrowG+1) = Xeq[0];\n"
"\n"
"\tStart();\n"
"\tfill_G( );\n"
"\n"
"//Restricciones de tension de cluster, ecs. (22)-(24)\n"
"//Entrada 1: [delta_the, V0Sigma, V0Delta, ValphaDelta, VbetaDelta,\n"
"//            Vcap1ap, Vcap2ap, Vcap3ap, Vcap1bp, ..., Vcap3cp, Vcap1an, ..."
", Vcap3cn]\n"
"\tdouble vCP[3], vCN[3];\n"
"\tfor (int x = 0; x < 3; x++){\n"
"\t\tvCP[x] = InputSignal(1, 5 + 3*x) + InputSignal(1, 6 + 3*x) + InputSignal"
"(1, 7 + 3*x);\n"
"\t\tvCN[x] = InputSignal(1, 14 + 3*x) + InputSignal(1, 15 + 3*x) + InputSign"
"al(1, 16 + 3*x);\n"
"\t}\n"
"\tMatricesConstraints(InputSignal(1, 1), InputSignal(1, 2), InputSignal(1, 3"
"), InputSignal(1, 4), vCP, vCN);\n"
"\n"
"\t //Calcular C\n"
"\n"
"\t //temp1 = T'Q\n"
"\t multiplicarMatrices(NrowG, NrowG, NrowG, T_trans, Q, temp1);\n"
"\n"
"\t //temp2 = 2(Sxk - xeq)\n"
"\t for(int i = 0; i < NrowG; i++){\n"
"        temp2[i][0] = 2*(Xk[i % 2] - Xeq[i]);\n"
"    }\n"
"    // c = temp1*temp2\n"
"\n"
"    for(int i = 0; i < NrowG; i++){\n"
"        c[i] = 0;\n"
"        for(int k = 0; k < NrowG; k++){\n"
"            c[i] += temp1[i][k] * temp2[k][0];\n"
"        }\n"
"    }\n"
"\n"
"\t//Optimizacion con restricciones (solucion exacta del QP)\n"
"\tdouble u_opt[NrowG];\n"
"\tresolver_qp(u_opt);\n"
"\tfor (int i = 0; i < NrowG; i++)\n"
"\t{\n"
"\t\tOutputSignal(0, i) = u_opt[i];\n"
"\t}\n"
"\t//0: sin restricciones activas, 1 o 2: restricciones activas, -1: sin solu"
"cion factible\n"
"\tOutputSignal(0, NrowG) = estado_qp;\n"
                Show          off
              }
