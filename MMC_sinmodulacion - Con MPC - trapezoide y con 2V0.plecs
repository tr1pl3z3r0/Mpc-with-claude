                Value         "//xk son estados actuales    \n"
"//xk  = {v_delta_alpha, v_delta_beta, v_delta_0, v_sigma_alpha, v_sigma_beta}"
"\n"
"    xk[0] = InputSignal(0, 0);\n"
"    xk[1] = InputSignal(0, 1);\n"
"    xk[2] = InputSignal(0, 2);\n"
"    xk[3] = InputSignal(0, 3);\n"
"    xk[4] = InputSignal(0, 4);\n"
"\n"
"//Valores para las matrices\n"
"\tVdc = InputSignal(1, 0);\n"
"\tIdc = InputSignal(1, 1);\n"
"\tialpha = InputSignal(1, 2);\n"
"\tibeta = InputSignal(1, 3);\n"
"\tvalpha = InputSignal(1, 4);\n"
"\tvbeta = InputSignal(1, 5);\n"
"\ttimer = InputSignal(1, 6);\n"
"\tthe = InputSignal(1, 7);\n"
"\t\n"
"\tK = Tsc/(n_c*C*Vc);\t\n"
"\t\n"
"\tVectores();\n"
"\tConstruir_Dk(Dk, valpha_vec, vbeta_vec, v0_vec, Vdc, ialpha_vec, ibeta_vec,"
" Idc_vec, K);\n"
"\tConstruir_B(B, valpha_vec, vbeta_vec, v0_vec, Vdc, K);\n"
"\tCalcular_H(H, B, q, r);\n"
"\tConstruir_F(F, Dk, xk, B, q);\n"
"\tConstruir_Uk(F, H, Uk);\n"
"\t\n"
"\tfor (int k = 0; k < 2*N; k++){\n"
"\t\tOutputSignal(0, k) = Uk[k];\n"
"\t};\n"
"\t\n"
"\tOutputSignal(0, 2*N) = v0_vec[N-1];"
